# Copy this to .env and fill in your values

# SQLite database path (relative to project root)
DATABASE_URL="file:./dev.db"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-here"

# The Odds API key — get a free key at https://the-odds-api.com
# Free tier: 500 requests/month
# Supported bookmakers: draftkings, fanduel, betmgm, caesars, pointsbetus
# Without a key, the app uses realistic mock data so you can still develop/test
ODDS_API_KEY="YOUR_ODDS_API_KEY_HERE"
